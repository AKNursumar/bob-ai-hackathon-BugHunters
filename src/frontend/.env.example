# =============================================================================
# Harborline Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# For Vercel production, set these in the Vercel project dashboard.
# NEVER commit .env.local — it is in .gitignore.
# =============================================================================

# ── Backend API URL ────────────────────────────────────────────────────────────
# Leave EMPTY for local development — Vite's dev proxy handles /api/* → backend.
# Set to your deployed Render backend URL for production.
#
# Local dev:  (leave commented out or set to empty string)
# VITE_API_URL=
#
# Production (set in Vercel dashboard):
# VITE_API_URL=https://harborline-backend.onrender.com
VITE_API_URL=
