# =============================================================================
# Harborline Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# ── AISStream ──────────────────────────────────────────────────────────────────
# Required for live AIS vessel tracking.
# Get a free key at https://aisstream.io
# If not set, AIS tracking is disabled (backend still works with forecast data).
AISSTREAM_API_KEY=your_aisstream_api_key_here

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development: http://localhost:5173 (default if not set)
# Production:  set to your Vercel deployment URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# CORS_ORIGINS=https://harborline.vercel.app

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default — safe for local dev and Render hackathon deploys):
DATABASE_URL=sqlite:///./harborline.db
# PostgreSQL (for persistent production storage):
# DATABASE_URL=postgresql://user:password@host:5432/harborline

# ── API Server ─────────────────────────────────────────────────────────────────
# Note: On Render, PORT is set automatically and overrides API_PORT.
API_HOST=0.0.0.0
API_PORT=8001
API_DEBUG=false

# ── ML Model Paths ─────────────────────────────────────────────────────────────
# Relative to src/backend (the backend working directory).
# Default values work when running from src/backend.
ML_MODEL_PATH=../AI/models
ML_DATA_PATH=../AI/data

# ── Indian Ports ───────────────────────────────────────────────────────────────
# Comma-separated list of active port IDs.
PORTS=port776,port777,port235,port540,port1367

# ── Optimisation ───────────────────────────────────────────────────────────────
OPTIMIZATION_TIMEOUT_SECONDS=30
OPTIMIZATION_LOG_SEARCH=false

# ── MCP / IBM Bob ──────────────────────────────────────────────────────────────
# MCP server runs inside FastAPI — no separate process needed.
MCP_ENABLED=true

# ── Operational Constraints ────────────────────────────────────────────────────
BERTH_COUNT_DEFAULT=5
CRANE_COUNT_DEFAULT=10
SERVICE_TIME_DEFAULT_HOURS=24
VESSEL_BERTH_COMPATIBILITY_STRICT=false